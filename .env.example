# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Polymarket Wallets to Watch (comma-separated wallet addresses)
# To find a wallet address from a username, run: python main.py --lookup rn1
WATCHED_WALLETS=0xADDRESS1,0xADDRESS2

# Polymarket usernames to resolve to wallet addresses on startup
WATCHED_USERNAMES=rn1

# Polling interval in seconds (how often to check for new trades)
POLL_INTERVAL=30

# Trader Discovery Settings
# Minimum number of trades for a trader to be considered
DISCOVERY_MIN_TRADES=10
# Minimum win rate (0.0 to 1.0) for discovery alerts
DISCOVERY_MIN_WIN_RATE=0.60
# Minimum ROI percentage for discovery alerts
DISCOVERY_MIN_ROI=15.0
# How many recent trades to analyze for discovery (from the global feed)
DISCOVERY_FEED_LIMIT=500

# Copy Trade Recommendation Thresholds
# Minimum trader win rate to recommend copying
COPY_TRADE_MIN_WIN_RATE=0.55
# Minimum market volume (USD) to recommend copying
COPY_TRADE_MIN_VOLUME=10000
